{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.build.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "types/**/*.ts",
    "instrumentation.ts",
    "proxy.ts",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "tests/**",
    "scripts/**",
    "playwright-report/**",
    "test-results/**"
  ]
}
