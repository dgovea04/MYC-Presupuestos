enum ContractType {
  SUMA_ALZADA
  PRECIOS_UNITARIOS
  MIXTO
  ADMINISTRACION
}

enum BudgetLevelType {
  TITLE
  SUBTITLE
  ITEM_GROUP
  SUBITEM
}

enum BudgetKind {
