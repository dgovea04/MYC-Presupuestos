  @@index([requestId, status])
  @@index([resourceId, createdAt(sort: Desc)])
  @@index([externalResourceId])
  @@map("resource_price_update_items")
}

model BudgetItemGenerationSource {
  id                     String                         @id @default(cuid())
  budgetItemId           String                         @unique
  budgetId               String
  sourceType             BudgetItemGenerationSourceType
  sourcePackageId        String?
  sourceCatalogPartidaId String?
  sourceItemId           String?
  catalogMatchScore      Decimal?                       @db.Decimal(10, 4)
  quantityConfidence     String?
  metadata               Json                           @default("{}")
  createdAt              DateTime                       @default(now())
  // budgetId is denormalized from budgetItem for query convenience
  // (find all generated items for a budget without joining through BudgetItem)
  budgetItem             BudgetItem                     @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  budget                 Budget                         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  sourcePackage          StoredProjectPackage?          @relation(fields: [sourcePackageId], references: [id], onDelete: SetNull)
  sourceCatalogPartida   CatalogPartida?                @relation(fields: [sourceCatalogPartidaId], references: [id], onDelete: SetNull)

  @@index([budgetId, createdAt(sort: Desc)])
  @@index([sourceType])
  @@index([sourcePackageId])
  @@map("budget_item_generation_sources")
}

model CatalogPartida {
  id                      String                       @id @default(cuid())
  description             String
  unit                    String
  unitPrice               Decimal                      @default(0) @db.Decimal(18, 4)
  currency                String                       @default("PEN")
  source                  String?
  performance             Decimal                      @default(1) @db.Decimal(18, 4)
  performanceUnit         String?
  performanceRate         String?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  apuRows                 PartidaApuRow[]
  usedAsSubpartidaRows    PartidaApuRow[]              @relation("CatalogSubpartidaRows")
  budgetApuSubpartidaRows ApuResource[]                @relation("BudgetApuCatalogSubpartida")
  generatedAsResult       GeneratedPartida[]           @relation("GeneratedCatalogPartida")
  generatedSources        GeneratedPartidaSource[]     @relation("GeneratedPartidaSourceCatalog")
  budgetItemGenSources    BudgetItemGenerationSource[]

  @@index([description])
}

model GeneratedPartida {
  id                        String                   @id @default(cuid())
  sourceText                String
  generatedName             String
  unit                      String
  similarityScore           Decimal                  @default(0) @db.Decimal(10, 4)
  createdById               String
  generatedCatalogPartidaId String?
  metadata                  Json                     @default("{}")
  createdAt                 DateTime                 @default(now())
  createdBy                 User                     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  generatedCatalogPartida   CatalogPartida?          @relation("GeneratedCatalogPartida", fields: [generatedCatalogPartidaId], references: [id], onDelete: SetNull)
  sources                   GeneratedPartidaSource[]
  insumos                   GeneratedPartidaInsumo[]

  @@index([createdById, createdAt(sort: Desc)])
  @@index([generatedCatalogPartidaId])
}

model GeneratedPartidaSource {
  id                 String           @id @default(cuid())
  generatedPartidaId String
  partidaSourceId    String
  score              Decimal          @default(0) @db.Decimal(10, 4)
  isPrimary          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  generatedPartida   GeneratedPartida @relation(fields: [generatedPartidaId], references: [id], onDelete: Cascade)
  partidaSource      CatalogPartida   @relation("GeneratedPartidaSourceCatalog", fields: [partidaSourceId], references: [id], onDelete: Restrict)

  @@unique([generatedPartidaId, partidaSourceId])
  @@index([partidaSourceId])
}

model GeneratedPartidaInsumo {
  id                 String           @id @default(cuid())
  generatedPartidaId String
  resourceId         String?
  description        String
  unit               String
  resourceType       String?
  suggestedQuantity  Decimal          @default(0) @db.Decimal(18, 4)
  finalQuantity      Decimal          @default(0) @db.Decimal(18, 4)
  unitPrice          Decimal          @default(0) @db.Decimal(18, 4)
  confidence         Decimal          @default(0) @db.Decimal(10, 4)
  confidenceLevel    String
  calculationMethod  String
  sourcePartidaIds   String[]         @default([])
  statistics         Json             @default("{}")
  createdAt          DateTime         @default(now())
  generatedPartida   GeneratedPartida @relation(fields: [generatedPartidaId], references: [id], onDelete: Cascade)
  resource           Resource?        @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([generatedPartidaId])
  @@index([resourceId])
}

model PartidaApuRow {
  id                  String          @id @default(cuid())
  catalogPartidaId    String
  resourceId          String?
  catalogSubpartidaId String?
  description         String
  unit                String
  crew                Decimal?        @db.Decimal(18, 4)
  quantity            Decimal         @default(0) @db.Decimal(18, 4)
  unitPrice           Decimal         @default(0) @db.Decimal(18, 4)
  subtotal            Decimal         @default(0) @db.Decimal(18, 4)
  resourceType        String?
  groupLabel          String?
  sortOrder           Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  catalogPartida      CatalogPartida  @relation(fields: [catalogPartidaId], references: [id], onDelete: Cascade)
  catalogSubpartida   CatalogPartida? @relation("CatalogSubpartidaRows", fields: [catalogSubpartidaId], references: [id], onDelete: SetNull)
  resource            Resource?       @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([catalogPartidaId])
  @@index([resourceId])
  @@index([catalogSubpartidaId])
}

model Apu {
  id            String        @id @default(cuid())
  budgetItemId  String        @unique
  name          String
  unit          String
  performance   Decimal       @default(1) @db.Decimal(18, 4)
  totalUnitCost Decimal       @default(0) @db.Decimal(18, 4)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  budgetItem    BudgetItem    @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  resources     ApuResource[]
}

model ApuResource {
  id                           String                        @id @default(cuid())
  apuId                        String
  resourceId                   String?
  catalogPartidaId             String?
  resourceType                 String
  crew                         Decimal?                      @db.Decimal(18, 4)
  quantity                     Decimal                       @default(0) @db.Decimal(18, 4)
  unitPrice                    Decimal                       @default(0) @db.Decimal(18, 4)
  subtotal                     Decimal                       @default(0) @db.Decimal(18, 4)
  nestedApuRows                Json?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  apu                          Apu                           @relation(fields: [apuId], references: [id], onDelete: Cascade)
  resource                     Resource?                     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  catalogPartida               CatalogPartida?               @relation("BudgetApuCatalogSubpartida", fields: [catalogPartidaId], references: [id], onDelete: SetNull)
  polynomialMonomialComponents PolynomialMonomialComponent[]

  @@index([apuId])
  @@index([resourceId])
  @@index([catalogPartidaId])
}

model GeneralExpense {
  id         String             @id @default(cuid())
  budgetId   String
  name       String
  type       GeneralExpenseType
  amount     Decimal?           @db.Decimal(18, 4)
  percentage Decimal?           @db.Decimal(10, 4)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  budget     Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model GeneralExpenseGroup {
  id        String                  @id @default(cuid())
  budgetId  String
  name      String
  kind      GeneralExpenseGroupKind
  sortOrder Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  budget    Budget                  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
