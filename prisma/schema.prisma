  company              Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProject        Project?                     @relation(fields: [sourceProjectId], references: [id], onDelete: SetNull)
  budgetItemGenSources BudgetItemGenerationSource[]

  @@unique([companyId, projectName])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("stored_project_packages")
}

// ─── Khipu Agent Platform V2 ────────────────────────────────────────────────

model AgentExecution {
  id                  String                @id @default(cuid())
  userId              String
  projectId           String?
  mode                String                @default("chat")
  state               String                @default("READ")
  goal                String
  summary             String?
  provider            String?
  model               String?
  startedAt           DateTime              @default(now())
  finishedAt          DateTime?
  lastError           String?
  contextSnapshotJson Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  steps               AgentExecutionStep[]
  toolInvocations     AgentToolInvocation[]
  approvals           AgentApproval[]
  rollbacks           AgentRollback[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId])
  @@index([state, createdAt(sort: Desc)])
  @@map("agent_executions")
}

model AgentExecutionStep {
  id               String                @id @default(cuid())
  executionId      String
  sequence         Int
  title            String
  objective        String
  toolName         String?
  status           String                @default("pending")
  approvalRequired Boolean               @default(false)
  inputJson        Json?
  resultSummary    String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  execution        AgentExecution        @relation(fields: [executionId], references: [id], onDelete: Cascade)
  toolInvocations  AgentToolInvocation[]
  approvals        AgentApproval[]
  rollbacks        AgentRollback[]

  @@index([executionId, sequence])
  @@map("agent_execution_steps")
}

model AgentToolInvocation {
  id            String              @id @default(cuid())
  executionId   String
  stepId        String?
  toolName      String
  argumentsJson Json
  resultJson    Json?
  latencyMs     Int?
  success       Boolean             @default(true)
  errorMessage  String?
  createdAt     DateTime            @default(now())
  execution     AgentExecution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step          AgentExecutionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([executionId, createdAt(sort: Desc)])
  @@index([stepId])
  @@index([toolName, createdAt(sort: Desc)])
  @@map("agent_tool_invocations")
}

model AgentApproval {
  id              String              @id @default(cuid())
  executionId     String
  stepId          String?
  decision        String?
  reason          String?
  requestedAt     DateTime            @default(now())
  decidedAt       DateTime?
  decidedByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  execution       AgentExecution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step            AgentExecutionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  decidedBy       User?               @relation("AgentApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@index([stepId])
  @@index([decidedByUserId])
  @@map("agent_approvals")
}

model AgentRollback {
  id                 String              @id @default(cuid())
  executionId        String
  stepId             String?
  rollbackToolName   String
  rollbackInputJson  Json?
  rollbackResultJson Json?
  success            Boolean             @default(true)
  errorMessage       String?
  reason             String?
  createdByUserId    String?
  createdAt          DateTime            @default(now())
  execution          AgentExecution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step               AgentExecutionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation("AgentRollbackCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@index([stepId])
  @@map("agent_rollbacks")
}

model AgentWorkflow {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  description         String
  initialGoalTemplate String
  allowedToolsJson    Json?
  defaultMode         String   @default("goal")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@map("agent_workflows")
}

model ProjectAttachment {
  id        String                    @id @default(cuid())
  projectId String
  fileName  String
  fileType  String
  fileSize  Int
  filePath  String
  category  ProjectAttachmentCategory @default(OTRO)
  userId    String
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  project   Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([category])
  @@map("project_attachments")
}
