generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum BudgetLevelType {
  TITLE
  SUBTITLE
  ITEM_GROUP
  SUBITEM
}

enum BudgetKind {
  GENERAL
  SUB_BUDGET
}

enum ResourceCategory {
  MATERIAL
  LABOR
  EQUIPMENT
  TOOLS
  SUBCONTRACT
}

enum GeneralExpenseType {
  PERCENTAGE
  FIXED
}

enum GeneralExpenseGroupKind {
  FIXED
  VARIABLE
}

enum GeneralExpenseItemCategory {
  STANDARD
  PERSONAL
  TESTING
  DIRECT_COST_BASED
}

enum ReportType {
  BUDGET_PDF
  BUDGET_EXCEL
  APU_EXCEL
}

enum PolynomialFormulaStatus {
  DRAFT
  VALID
  ARCHIVED
}

enum PolynomialCostGroup {
  LABOR
  MATERIALS
  EQUIPMENT
  OTHERS
  GENERAL_EXPENSES_PROFIT
  STEEL
  CEMENT
  MASONRY
  INSTALLATIONS
}

enum ActivityEventType {
  PROJECT_CREATED
  PROJECT_UPDATED
  BUDGET_CREATED
  BUDGET_UPDATED
  POLYNOMIAL_FORMULA_GENERATED
  POLYNOMIAL_FORMULA_UPDATED
  ADJUSTMENT_REGISTERED
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AiTokenLedgerType {
  RESERVE
  CONSUME
  RELEASE
  ADJUSTMENT
}

enum AiSuggestionFeedbackType {
  APPLIED
  EDITED
  DISMISSED
}

enum AiProjectMemoryType {
  FACT
  PREFERENCE
  CONSTRAINT
  ASSUMPTION
}

enum BillingMode {
  FREE
  STRIPE
  MANUAL
}

enum BillingProvider {
  STRIPE
  MANUAL
}

enum BillingSubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum RiskVariableType {
  QUANTITY
}

enum RiskDistributionType {
  TRIANGULAR
}

enum NoteTaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum NoteTaskStatus {
  OPEN
  RESOLVED
}

enum MetradoTemplateType {
  CONCRETE
  REBAR
  FORMWORK
  MASONRY
  PLASTER
  PAINT
  EXCAVATION
  FLOORING
  ROOFING
  CUSTOM
}

enum MetradoSheetStatus {
  DRAFT
  VALIDATED
  SENT_TO_BUDGET
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  avatarUrl           String?
  phone               String?
  jobTitle            String?
  bio                 String?
  role                UserRole  @default(USER)
  status              UserStatus @default(ACTIVE)
  membershipPlanId    String?
  aiTokenExtraMonthly Int       @default(0)
  passwordHash        String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  companies           Company[]
  settings            UserSettings?
  activityEvents ActivityEvent[]
  membershipPlan      MembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  aiUsagePeriods      AiUsagePeriod[]
  aiTokenLedger       AiTokenLedger[] @relation("AiTokenLedgerUser")
  aiTokenAdjustments  AiTokenLedger[] @relation("AiTokenLedgerAdmin")
  aiProjectHistoryEntries AiProjectHistoryEntry[]
  aiSuggestionFeedbackEvents AiSuggestionFeedbackEvent[]
  billingSubscriptions BillingSubscription[]
  noteTasks           NoteTask[]
  generatedPartidas   GeneratedPartida[]
  metradoSheets       MetradoSheet[]
  customMetradoFormulas CustomMetradoFormula[]
  budgetTemplates     BudgetTemplate[]

  @@index([role])
  @@index([status])
  @@index([membershipPlanId])
}

model MembershipPlan {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  monthlyTokenLimit Int
  billingMode       BillingMode @default(FREE)
  stripePriceId     String?
  projectLimit      Int?
  budgetLimit       Int?
  entitlements      String[] @default([])
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  users             User[]

  @@index([isActive])
  @@index([billingMode])
  @@index([stripePriceId])
}

model BillingSubscription {
  id                   String                    @id @default(cuid())
  userId               String
  provider             BillingProvider
  status               BillingSubscriptionStatus
  stripeCustomerId     String?
  stripeSubscriptionId String?                   @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean                   @default(false)
  pastDueStartedAt     DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([stripeCustomerId])
  @@index([status])
}

model BillingWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
  payload        Json

  @@index([type, processedAt(sort: Desc)])
}

model AiUsagePeriod {
  id             String   @id @default(cuid())
  userId         String
  periodStart    DateTime
  consumedTokens Int      @default(0)
  reservedTokens Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([periodStart])
}

model AiTokenLedger {
  id              String            @id @default(cuid())
  userId          String
  adminUserId     String?
  periodStart     DateTime
  type            AiTokenLedgerType
  tokens          Int
  estimatedTokens Int?
  actualTokens    Int?
  provider        String
  model           String
  action          String
  notes           String?
  createdAt       DateTime          @default(now())
  user            User              @relation("AiTokenLedgerUser", fields: [userId], references: [id], onDelete: Cascade)
  adminUser       User?             @relation("AiTokenLedgerAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([userId, periodStart])
  @@index([adminUserId])
  @@index([action, createdAt(sort: Desc)])
}

model AiProjectHistoryEntry {
  id             String   @id @default(cuid())
  projectId      String
  userId         String
  action         String
  summary        String
  context        Json
  answer         String
  structuredData Json?
  model          String
  requestedModel String
  fallbackUsed   Boolean  @default(false)
  warnings       String[] @default([])
  latencyMs      Int?
  provider       String?
  task           String?
  promptHash     String?
  responseHash   String?
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbackEvents AiSuggestionFeedbackEvent[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([provider, createdAt(sort: Desc)])
  @@index([task, createdAt(sort: Desc)])
}

model AiSuggestionFeedbackEvent {
  id             String                   @id @default(cuid())
  historyEntryId String
  userId         String
  projectId      String
  feedbackType   AiSuggestionFeedbackType
  notes          String?
  provider       String?
  model          String?
  task           String?
  suggestionType String?
  actionType     String?
  promptHash     String?
  responseHash   String?
  createdAt      DateTime                 @default(now())
  historyEntry   AiProjectHistoryEntry    @relation(fields: [historyEntryId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([historyEntryId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([feedbackType, createdAt(sort: Desc)])
  @@index([provider, createdAt(sort: Desc)])
  @@index([task, createdAt(sort: Desc)])
}

model ActivityEvent {
  id        String            @id @default(cuid())
  userId    String
  type      ActivityEventType
  title     String
  detail    String
  href      String
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

model SystemSettings {
  id             String   @id @default(cuid())
  singletonKey   String   @unique @default("system")
  openaiApiKey   String?
  geminiApiKey   String?
  openaiModel    String?
  geminiModel    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([singletonKey])
}

model UserSettings {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  currencyDecimals           Int      @default(2)
  defaultCurrency            String   @default("PEN")
  dateFormat                 String   @default("DD_MMM_YYYY")
  defaultViewMode            String   @default("modern")
  excelShowFieldBorders      Boolean  @default(true)
  excelRowHeight             Int      @default(52)
  defaultIgvRate             Decimal  @default(0.18) @db.Decimal(10, 4)
  defaultGeneralExpensesRate Decimal  @default(0.10) @db.Decimal(10, 4)
  defaultUtilityRate         Decimal  @default(0.08) @db.Decimal(10, 4)
  defaultSubBudgetNames      String[] @default(["Estructuras", "Arquitectura", "Instalaciones Sanitarias", "Instalaciones Electricas"])
  openaiApiKey               String?
  geminiApiKey               String?
  aiProviderPreference       String   @default("auto")
  openaiModel                String?
  geminiModel                String?
  floatingKhipuProvider      String   @default("ollama")
  floatingKhipuWidth         Int      @default(600)
  floatingKhipuHeight        Int      @default(500)
  floatingKhipuFontSize      String   @default("normal")
  floatingKhipuPosition      String   @default("bottom-right")
  floatingKhipuTheme         String   @default("light")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id         String     @id @default(cuid())
  userId     String
  name       String
  ruc        String?
  logoUrl    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects   Project[]
  resources  Resource[]

  @@index([userId])
}

model Project {
  id          String        @id @default(cuid())
  companyId   String
  name        String
  clientName  String?
  location    String?
  projectType String?
  startDate   DateTime?
  endDate     DateTime?
  status      ProjectStatus @default(PLANNING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  budgets     Budget[]
  polynomialFormulas PolynomialFormula[]
  noteTasks   NoteTask[]
  metradoSheets MetradoSheet[]
  budgetTemplates BudgetTemplate[]
  aiProjectHistoryEntries AiProjectHistoryEntry[]
  aiSuggestionFeedbackEvents AiSuggestionFeedbackEvent[]
  aiMemory AiProjectMemory[]

  @@index([companyId])
}

model AiProjectMemory {
  id         String              @id @default(cuid())
  projectId  String
  memoryType AiProjectMemoryType @default(FACT)
  fact       String
  confidence Decimal             @default(0.8) @db.Decimal(4, 3)
  source     String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([memoryType])
  @@map("project_ai_memory")
}

model Budget {
  id                    String          @id @default(cuid())
  projectId             String
  parentBudgetId        String?
  kind                  BudgetKind      @default(GENERAL)
  name                  String
  currency              String          @default("PEN")
  igvRate               Decimal         @default(0.18) @db.Decimal(10, 4)
  generalExpensesRate   Decimal         @default(0.10) @db.Decimal(10, 4)
  utilityRate           Decimal         @default(0.08) @db.Decimal(10, 4)
  totalDirectCost       Decimal         @default(0) @db.Decimal(18, 4)
  totalGeneralExpenses  Decimal         @default(0) @db.Decimal(18, 4)
  totalUtility          Decimal         @default(0) @db.Decimal(18, 4)
  totalTax              Decimal         @default(0) @db.Decimal(18, 4)
  totalAmount           Decimal         @default(0) @db.Decimal(18, 4)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  project               Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentBudget          Budget?         @relation("BudgetHierarchy", fields: [parentBudgetId], references: [id], onDelete: SetNull)
  childBudgets          Budget[]        @relation("BudgetHierarchy")
  levels                BudgetLevel[]
  items                 BudgetItem[]
  generalExpenses       GeneralExpense[]
  generalExpenseGroups  GeneralExpenseGroup[]
  footerRows            BudgetFooterRow[]
  polynomialFormulas    PolynomialFormula[]
  workSchedule         WorkSchedule?
  valuations            Valuation[]
  reports               Report[]
  riskVariables         RiskVariable[]
  riskSimulationRuns    RiskSimulationRun[]
  noteTasks             NoteTask[]
  metradoSheets         MetradoSheet[]
  budgetTemplates       BudgetTemplate[]

  @@index([projectId])
  @@index([parentBudgetId])
  @@unique([id, projectId])
}

model BudgetTemplate {
  id              String   @id @default(cuid())
  userId          String
  sourceProjectId String?
  sourceBudgetId  String?
  module          String   @default("BUDGET")
  name            String
  description     String   @default("")
  payload         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProject   Project? @relation(fields: [sourceProjectId], references: [id], onDelete: SetNull)
  sourceBudget    Budget?  @relation(fields: [sourceBudgetId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt(sort: Desc)])
  @@index([sourceProjectId])
  @@index([sourceBudgetId])
  @@map("budget_templates")
}

model BudgetLevel {
  id        String        @id @default(cuid())
  budgetId  String
  parentId  String?
  type      BudgetLevelType
  code      String
  name      String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  budget    Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  parent    BudgetLevel?  @relation("BudgetLevelTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  BudgetLevel[] @relation("BudgetLevelTree")
  items     BudgetItem[]

  @@index([budgetId])
  @@index([parentId])
}

model BudgetItem {
  id          String       @id @default(cuid())
  budgetId    String
  levelId     String?
  code        String
  description String
  unit        String
  quantity    Decimal      @default(0) @db.Decimal(18, 4)
  unitPrice   Decimal      @default(0) @db.Decimal(18, 4)
  partial     Decimal      @default(0) @db.Decimal(18, 4)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  budget      Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  level       BudgetLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  apu         Apu?
  workScheduleItems WorkScheduleItem[]
  polynomialMonomialComponents PolynomialMonomialComponent[]
  riskVariables RiskVariable[]
  noteTasks     NoteTask[]
  metradoLinks  MetradoPartidaLink[]

  @@index([budgetId])
  @@index([levelId])
  @@unique([id, budgetId])
}

model MetradoTemplate {
  id          String              @id @default(cuid())
  type        MetradoTemplateType @unique
  name        String
  description String
  defaultUnit String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  sheets      MetradoSheet[]
  formulas    MetradoFormula[]

  @@map("metrado_templates")
}

model MetradoFormula {
  id             String          @id @default(cuid())
  templateId     String
  key            String
  label          String
  expression     String
  requiredInputs String[]        @default([])
  resultUnit     String
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  template       MetradoTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId])
  @@map("metrado_formulas")
}

model MetradoSheet {
  id            String              @id @default(cuid())
  userId        String
  projectId     String
  budgetId      String
  templateId    String
  name          String
  status        MetradoSheetStatus  @default(DRAFT)
  unit          String
  totalQuantity Decimal             @default(0) @db.Decimal(18, 4)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budget        Budget              @relation(fields: [budgetId, projectId], references: [id, projectId], onDelete: Cascade)
  template      MetradoTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  rows          MetradoRow[]
  partidaLinks  MetradoPartidaLink[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([projectId])
  @@index([budgetId])
  @@index([templateId])
  @@unique([id, budgetId])
  @@map("metrado_sheets")
}

model MetradoRow {
  id          String       @id @default(cuid())
  sheetId     String
  sector      String       @default("")
  eje         String       @default("")
  nivel       String       @default("")
  description String
  unit        String
  formulaKey  String
  inputs      Json         @default("{}")
  partial     Decimal      @default(0) @db.Decimal(18, 4)
  groupLabel  String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sheet       MetradoSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([sheetId, sortOrder])
  @@map("metrado_rows")
}

model MetradoPartidaLink {
  id               String       @id @default(cuid())
  sheetId          String
  budgetId         String
  budgetItemId     String
  lastSentQuantity Decimal?     @db.Decimal(18, 4)
  sentAt           DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  sheet            MetradoSheet @relation(fields: [sheetId, budgetId], references: [id, budgetId], onDelete: Cascade)
  budgetItem       BudgetItem   @relation(fields: [budgetItemId, budgetId], references: [id, budgetId], onDelete: Cascade)

  @@unique([sheetId, budgetItemId])
  @@index([sheetId, budgetId])
  @@index([budgetItemId])
  @@index([budgetItemId, budgetId])
  @@map("metrado_partida_links")
}

model CustomMetradoFormula {
  id             String   @id @default(cuid())
  userId         String
  name           String
  description    String   @default("")
  category       String   @default("Personalizado")
  expression     String
  requiredInputs String[] @default([])
  resultUnit     String
  showInSuggestions Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@unique([userId, name])
  @@map("custom_metrado_formulas")
}

model NoteTask {
  id           String           @id @default(cuid())
  userId       String
  projectId    String?
  budgetId     String?
  budgetItemId String?
  body         String
  priority     NoteTaskPriority @default(MEDIUM)
  status       NoteTaskStatus   @default(OPEN)
  sourcePath   String
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budget       Budget?          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetItem   BudgetItem?      @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([projectId])
  @@index([budgetId])
  @@index([budgetItemId])
  @@index([sourcePath])
}

model RiskVariable {
  id               String               @id @default(cuid())
  budgetId         String
  budgetItemId     String
  variableType     RiskVariableType     @default(QUANTITY)
  distributionType RiskDistributionType @default(TRIANGULAR)
  minimum          Decimal              @default(0) @db.Decimal(18, 4)
  mostLikely       Decimal              @default(0) @db.Decimal(18, 4)
  maximum          Decimal              @default(0) @db.Decimal(18, 4)
  enabled          Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  budget           Budget               @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetItem       BudgetItem           @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)

  @@unique([budgetId, budgetItemId, variableType])
  @@index([budgetId])
  @@index([budgetItemId])
}

model RiskSimulationRun {
  id                String   @id @default(cuid())
  budgetId          String
  iterations        Int
  baseTotal         Decimal  @default(0) @db.Decimal(18, 4)
  mean              Decimal  @default(0) @db.Decimal(18, 4)
  median            Decimal  @default(0) @db.Decimal(18, 4)
  variance          Decimal  @default(0) @db.Decimal(24, 6)
  standardDeviation Decimal  @default(0) @db.Decimal(18, 4)
  skewness          Decimal  @default(0) @db.Decimal(18, 6)
  kurtosis          Decimal  @default(0) @db.Decimal(18, 6)
  p10               Decimal  @default(0) @db.Decimal(18, 4)
  p50               Decimal  @default(0) @db.Decimal(18, 4)
  p80               Decimal  @default(0) @db.Decimal(18, 4)
  p90               Decimal  @default(0) @db.Decimal(18, 4)
  p95               Decimal  @default(0) @db.Decimal(18, 4)
  histogramBins     Json
  sCurvePoints      Json
  createdAt         DateTime @default(now())
  budget            Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId, createdAt(sort: Desc)])
}

model WorkSchedule {
  id        String             @id @default(cuid())
  budgetId  String             @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  budget    Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  items     WorkScheduleItem[]

  @@index([budgetId])
}

model WorkScheduleItem {
  id            String                     @id @default(cuid())
  scheduleId    String
  budgetItemId  String
  startDate     DateTime
  endDate       DateTime
  durationDays  Int
  predecessor   String?
  crew          Decimal?                   @db.Decimal(18, 4)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  schedule      WorkSchedule               @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  budgetItem    BudgetItem                 @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  distributions WorkScheduleDistribution[]

  @@unique([scheduleId, budgetItemId])
  @@index([scheduleId])
  @@index([budgetItemId])
}

model WorkScheduleDistribution {
  id             String           @id @default(cuid())
  scheduleItemId String
  year           Int
  month          Int
  percentage     Decimal          @db.Decimal(10, 4)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  scheduleItem   WorkScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)

  @@unique([scheduleItemId, year, month])
  @@index([scheduleItemId])
  @@index([year, month])
}

model Resource {
  id           String           @id @default(cuid())
  companyId    String?
  code         String
  description  String
  category     ResourceCategory
  iu           String?
  iuCurrent    String?
  iuCurrentReviewStatus String?
  subcategory  String?
  unit         String
  unitPrice    Decimal          @default(0) @db.Decimal(18, 4)
  currency     String           @default("PEN")
  source       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  company      Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  apuResources ApuResource[]
  partidaRows  PartidaApuRow[]
  generatedPartidaInsumos GeneratedPartidaInsumo[]

  @@index([companyId])
}

model CatalogPartida {
  id              String          @id @default(cuid())
  description     String
  unit            String
  unitPrice       Decimal         @default(0) @db.Decimal(18, 4)
  currency        String          @default("PEN")
  source          String?
  performance     Decimal         @default(1) @db.Decimal(18, 4)
  performanceUnit String?
  performanceRate String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  apuRows         PartidaApuRow[]
  usedAsSubpartidaRows PartidaApuRow[] @relation("CatalogSubpartidaRows")
  budgetApuSubpartidaRows ApuResource[] @relation("BudgetApuCatalogSubpartida")
  generatedAsResult GeneratedPartida[] @relation("GeneratedCatalogPartida")
  generatedSources  GeneratedPartidaSource[] @relation("GeneratedPartidaSourceCatalog")

  @@index([description])
}

model GeneratedPartida {
  id                        String                    @id @default(cuid())
  sourceText                String
  generatedName             String
  unit                      String
  similarityScore           Decimal                   @default(0) @db.Decimal(10, 4)
  createdById               String
  generatedCatalogPartidaId String?
  metadata                  Json                      @default("{}")
  createdAt                 DateTime                  @default(now())
  createdBy                 User                      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  generatedCatalogPartida   CatalogPartida?           @relation("GeneratedCatalogPartida", fields: [generatedCatalogPartidaId], references: [id], onDelete: SetNull)
  sources                   GeneratedPartidaSource[]
  insumos                   GeneratedPartidaInsumo[]

  @@index([createdById, createdAt(sort: Desc)])
  @@index([generatedCatalogPartidaId])
}

model GeneratedPartidaSource {
  id                 String           @id @default(cuid())
  generatedPartidaId String
  partidaSourceId    String
  score              Decimal          @default(0) @db.Decimal(10, 4)
  isPrimary          Boolean          @default(false)
  createdAt          DateTime         @default(now())
  generatedPartida   GeneratedPartida @relation(fields: [generatedPartidaId], references: [id], onDelete: Cascade)
  partidaSource      CatalogPartida   @relation("GeneratedPartidaSourceCatalog", fields: [partidaSourceId], references: [id], onDelete: Restrict)

  @@unique([generatedPartidaId, partidaSourceId])
  @@index([partidaSourceId])
}

model GeneratedPartidaInsumo {
  id                 String           @id @default(cuid())
  generatedPartidaId String
  resourceId         String?
  description        String
  unit               String
  resourceType       String?
  suggestedQuantity  Decimal          @default(0) @db.Decimal(18, 4)
  finalQuantity      Decimal          @default(0) @db.Decimal(18, 4)
  unitPrice          Decimal          @default(0) @db.Decimal(18, 4)
  confidence         Decimal          @default(0) @db.Decimal(10, 4)
  confidenceLevel    String
  calculationMethod  String
  sourcePartidaIds   String[]         @default([])
  statistics         Json             @default("{}")
  createdAt          DateTime         @default(now())
  generatedPartida   GeneratedPartida @relation(fields: [generatedPartidaId], references: [id], onDelete: Cascade)
  resource           Resource?        @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([generatedPartidaId])
  @@index([resourceId])
}

model PartidaApuRow {
  id               String         @id @default(cuid())
  catalogPartidaId String
  resourceId       String?
  catalogSubpartidaId String?
  description      String
  unit             String
  crew             Decimal?       @db.Decimal(18, 4)
  quantity         Decimal        @default(0) @db.Decimal(18, 4)
  unitPrice        Decimal        @default(0) @db.Decimal(18, 4)
  subtotal         Decimal        @default(0) @db.Decimal(18, 4)
  resourceType     String?
  groupLabel       String?
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  catalogPartida   CatalogPartida @relation(fields: [catalogPartidaId], references: [id], onDelete: Cascade)
  catalogSubpartida CatalogPartida? @relation("CatalogSubpartidaRows", fields: [catalogSubpartidaId], references: [id], onDelete: SetNull)
  resource         Resource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([catalogPartidaId])
  @@index([resourceId])
  @@index([catalogSubpartidaId])
}

model Apu {
  id            String        @id @default(cuid())
  budgetItemId  String        @unique
  name          String
  unit          String
  performance   Decimal       @default(1) @db.Decimal(18, 4)
  totalUnitCost Decimal       @default(0) @db.Decimal(18, 4)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  budgetItem    BudgetItem    @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  resources     ApuResource[]
}

model ApuResource {
  id           String    @id @default(cuid())
  apuId        String
  resourceId   String?
  catalogPartidaId String?
  resourceType String
  crew         Decimal?  @db.Decimal(18, 4)
  quantity     Decimal   @default(0) @db.Decimal(18, 4)
  unitPrice    Decimal   @default(0) @db.Decimal(18, 4)
  subtotal     Decimal   @default(0) @db.Decimal(18, 4)
  nestedApuRows Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  apu          Apu       @relation(fields: [apuId], references: [id], onDelete: Cascade)
  resource     Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  catalogPartida CatalogPartida? @relation("BudgetApuCatalogSubpartida", fields: [catalogPartidaId], references: [id], onDelete: SetNull)
  polynomialMonomialComponents PolynomialMonomialComponent[]

  @@index([apuId])
  @@index([resourceId])
  @@index([catalogPartidaId])
}

model GeneralExpense {
  id         String             @id @default(cuid())
  budgetId   String
  name       String
  type       GeneralExpenseType
  amount     Decimal?           @db.Decimal(18, 4)
  percentage Decimal?           @db.Decimal(10, 4)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  budget     Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model GeneralExpenseGroup {
  id         String                  @id @default(cuid())
  budgetId   String
  name       String
  kind       GeneralExpenseGroupKind
  sortOrder  Int                     @default(0)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  budget     Budget                  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  titles     GeneralExpenseTitle[]

  @@index([budgetId])
}

model GeneralExpenseTitle {
  id         String               @id @default(cuid())
  groupId    String
  code       String
  name       String
  category   GeneralExpenseItemCategory @default(STANDARD)
  sortOrder  Int                  @default(0)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  group      GeneralExpenseGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  items      GeneralExpenseItem[]

  @@index([groupId])
}

model GeneralExpenseItem {
  id                      String                     @id @default(cuid())
  titleId                 String
  code                    String
  description             String
  category                GeneralExpenseItemCategory
  unit                    String
  quantityDescription     String?
  quantity                Decimal                    @default(0) @db.Decimal(18, 4)
  participationPercentage Decimal                    @default(0) @db.Decimal(10, 4)
  unitPrice               Decimal                    @default(0) @db.Decimal(18, 4)
  sortOrder               Int                        @default(0)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  title                   GeneralExpenseTitle        @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@index([titleId])
}

model BudgetFooterRow {
  id          String   @id @default(cuid())
  budgetId    String
  variable    String
  description String
  formula     String?
  manualValue Decimal  @default(0) @db.Decimal(18, 4)
  iu          String?
  highlight   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model Report {
  id        String     @id @default(cuid())
  budgetId  String
  type      ReportType
  fileUrl   String
  createdAt DateTime   @default(now())
  budget    Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model PolynomialFormula {
  id              String                  @id @default(cuid())
  projectId        String
  budgetId        String
  name            String
  baseMonth       Int
  baseYear        Int
  totalBaseAmount Decimal                 @default(0) @db.Decimal(18, 2)
  status          PolynomialFormulaStatus @default(DRAFT)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budget          Budget                  @relation(fields: [budgetId, projectId], references: [id, projectId], onDelete: Cascade)
  monomials       PolynomialMonomial[]
  valuations      Valuation[]
  adjustments     AdjustmentCalculation[]

  @@index([projectId])
  @@index([budgetId])
  @@index([baseYear, baseMonth])
  @@unique([id, budgetId])
}

model PolynomialMonomial {
  id                   String                       @id @default(cuid())
  formulaId            String
  code                 String
  name                 String
  costGroupKey         PolynomialCostGroup
  amount               Decimal                      @default(0) @db.Decimal(18, 2)
  coefficient          Decimal                      @default(0) @db.Decimal(12, 3)
  baseIndexCode        String
  baseIndexName        String
  baseIndexValue       Decimal                      @default(0) @db.Decimal(18, 3)
  adjustmentIndexCode  String?
  adjustmentIndexName  String?
  adjustmentIndexValue Decimal?                     @db.Decimal(18, 3)
  sortOrder            Int                          @default(0)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  formula              PolynomialFormula            @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  components           PolynomialMonomialComponent[]
  adjustmentTerms      AdjustmentCalculationTerm[]

  @@index([formulaId])
  @@index([costGroupKey])
  @@unique([formulaId, sortOrder])
}

model PolynomialMonomialComponent {
  id           String             @id @default(cuid())
  monomialId   String
  budgetItemId String?
  apuResourceId String?
  resourceType String?
  amount       Decimal            @default(0) @db.Decimal(18, 2)
  unifiedIndexCode            String?
  unifiedIndexName            String?
  iuFamily                    String?
  participationPercentage     Decimal?           @db.Decimal(12, 6)
  coefficientContribution     Decimal?           @db.Decimal(12, 6)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  monomial     PolynomialMonomial @relation(fields: [monomialId], references: [id], onDelete: Cascade)
  budgetItem   BudgetItem?        @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  apuResource  ApuResource?       @relation(fields: [apuResourceId], references: [id], onDelete: SetNull)

  @@index([monomialId])
  @@index([budgetItemId])
  @@index([apuResourceId])
  @@index([unifiedIndexCode])
}

model UnifiedIndex {
  id             String   @id @default(cuid())
  code           String
  name           String
  category       String?
  geographicArea String   @default("UNSPECIFIED")
  month          Int
  year           Int
  value          Decimal  @default(0) @db.Decimal(18, 3)
  source         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([code, geographicArea, month, year])
  @@index([year, month])
}

model Valuation {
  id         String               @id @default(cuid())
  budgetId   String
  formulaId  String?
  month      Int
  year       Int
  amount     Decimal              @default(0) @db.Decimal(18, 2)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  budget     Budget               @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  formula    PolynomialFormula?   @relation(fields: [formulaId, budgetId], references: [id, budgetId], onDelete: Cascade)
  adjustments AdjustmentCalculation[]

  @@unique([budgetId, year, month])
  @@index([formulaId])
  @@unique([id, formulaId, year, month])
}

model AdjustmentCalculation {
  id               String                       @id @default(cuid())
  formulaId        String
  valuationId      String
  month            Int
  year             Int
  originalAmount   Decimal                      @default(0) @db.Decimal(18, 2)
  adjustedAmount   Decimal                      @default(0) @db.Decimal(18, 2)
  adjustmentAmount Decimal                      @default(0) @db.Decimal(18, 2)
  kRaw             Decimal                      @default(0) @db.Decimal(18, 6)
  kRounded         Decimal                      @default(0) @db.Decimal(12, 3)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  formula          PolynomialFormula            @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  valuation        Valuation                    @relation(fields: [valuationId, formulaId, year, month], references: [id, formulaId, year, month], onDelete: Cascade)
  terms            AdjustmentCalculationTerm[]

  @@unique([formulaId, year, month])
  @@unique([valuationId])
}

model AdjustmentCalculationTerm {
  id                   String                 @id @default(cuid())
  adjustmentId         String
  monomialId           String
  name                 String
  coefficient          Decimal                @default(0) @db.Decimal(12, 3)
  baseIndexValue       Decimal                @default(0) @db.Decimal(18, 3)
  adjustmentIndexValue Decimal                @default(0) @db.Decimal(18, 3)
  ratio                Decimal                @default(0) @db.Decimal(18, 6)
  partial              Decimal                @default(0) @db.Decimal(18, 6)
  sortOrder            Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  adjustment           AdjustmentCalculation  @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  monomial             PolynomialMonomial     @relation(fields: [monomialId], references: [id], onDelete: Cascade)

  @@index([adjustmentId])
  @@index([monomialId])
  @@unique([adjustmentId, sortOrder])
}
