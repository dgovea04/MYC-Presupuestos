enum LocalResourcePriceBatchStatus {
  DRAFT
  PREVIEW_READY
  PUBLISHED
  REJECTED
  ROLLED_BACK
}

enum LocalResourcePriceBatchSource {
  EXCEL
  MANUAL
  ROLLBACK
}

enum LocalResourcePriceItemStatus {
  VALID
  INVALID
  UNCHANGED
