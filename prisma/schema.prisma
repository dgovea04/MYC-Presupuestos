  VARIABLE
}

enum GeneralExpenseItemCategory {
  STANDARD
  PERSONAL
  TESTING
  DIRECT_COST_BASED
}

enum ReportType {
  BUDGET_PDF
  BUDGET_EXCEL
  APU_EXCEL
}

enum PolynomialFormulaStatus {
  DRAFT
  VALID
  ARCHIVED
}

enum PolynomialCostGroup {
  LABOR
  MATERIALS
  EQUIPMENT
  OTHERS
  GENERAL_EXPENSES_PROFIT
  STEEL
  CEMENT
  MASONRY
  INSTALLATIONS
}

enum ProjectAttachmentCategory {
  PLANO
  ESPECIFICACION
  CONTRATO
  MEMORIA
  FOTO
  OTRO
}

enum ActivityEventType {
  PROJECT_CREATED
  PROJECT_UPDATED
  BUDGET_CREATED
  BUDGET_UPDATED
  POLYNOMIAL_FORMULA_GENERATED
  POLYNOMIAL_FORMULA_UPDATED
  ADJUSTMENT_REGISTERED
}

enum UserRole {
  ADMIN
  USER
}

enum AdminProfile {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  BILLING_ADMIN
  AUDITOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AiTokenLedgerType {
  RESERVE
  CONSUME
  RELEASE
  ADJUSTMENT
}

enum AiSuggestionFeedbackType {
  APPLIED
  EDITED
  DISMISSED
}

enum AiProjectMemoryType {
  FACT
  PREFERENCE
  CONSTRAINT
  ASSUMPTION
}

enum BillingMode {
  FREE
  STRIPE
  MANUAL
}

enum BillingProvider {
  STRIPE
  MANUAL
}

enum BillingSubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum BetaCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  FINISHED
}

enum BetaAssignmentMode {
  AUTOMATIC
  ADMIN
  CODE
  MIXED
}

enum BetaGrantStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
  REVOKED
}

enum BetaGrantSource {
  AUTOMATIC
  ADMIN
  CODE
  IMPORT
}

enum BetaApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RiskVariableType {
  QUANTITY
  UNIT_PRICE
  DURATION
}

enum RiskDistributionType {
  TRIANGULAR
  PERT
  NORMAL
  UNIFORM
}

enum RiskScenarioSource {
  MANUAL
  AGENT
}

enum RiskScenarioStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum RiskInputSource {
  MANUAL
  AGENT
  HEURISTIC
}

enum NoteTaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum NoteTaskStatus {
  OPEN
  RESOLVED
}

enum CollaborationEntityType {
  BUDGET
  BUDGET_ITEM
  APU
  APU_RESOURCE
  METRADO_SHEET
  METRADO_ROW
  WORK_SCHEDULE_ITEM
}

enum CollaborationPresenceStatus {
  ACTIVE
  IDLE
}

enum CollaborationChangeSource {
  USER
  SYSTEM
  KHIPU
}

enum BudgetItemGenerationSourceType {
  MCP_TEMPLATE
  CATALOG_MATCH
  AI_DESCRIPTION
}

enum MetradoTemplateType {
  CONCRETE
  REBAR
  FORMWORK
  MASONRY
  PLASTER
  PAINT
  EXCAVATION
  FLOORING
  ROOFING
  CUSTOM
}

enum MetradoSheetStatus {
  DRAFT
  VALIDATED
  SENT_TO_BUDGET
}

enum CompanyMembershipRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum CompanyMembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id                            String                      @id @default(cuid())
  name                          String
  email                         String                      @unique
  emailVerifiedAt               DateTime?
  avatarUrl                     String?
  phone                         String?
  jobTitle                      String?
  bio                           String?
  role                          UserRole                    @default(USER)
  adminProfile                  AdminProfile?
  status                        UserStatus                  @default(ACTIVE)
  isSuperAdmin                  Boolean                     @default(false)
  mfaEnabled                    Boolean                     @default(false)
  mfaSecretEncrypted            String?
  passwordChangedAt             DateTime?
  sessionVersion                Int                         @default(0)
  deletionScheduledAt           DateTime?
  deletionReason                String?
  deletionPreviousStatus        UserStatus?
  membershipPlanId              String?
  aiTokenExtraMonthly           Int                         @default(0)
  passwordHash                  String?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  companies                     Company[]
  companyMemberships            CompanyMembership[]
  settings                      UserSettings?
  activityEvents                 ActivityEvent[]
  marketingEvents                MarketingEvent[]
  membershipPlan                 MembershipPlan?             @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  aiUsagePeriods                AiUsagePeriod[]
  aiTokenLedger                 AiTokenLedger[]             @relation("AiTokenLedgerUser")
  aiTokenAdjustments            AiTokenLedger[]             @relation("AiTokenLedgerAdmin")
  aiProjectHistoryEntries       AiProjectHistoryEntry[]
  aiSuggestionFeedbackEvents    AiSuggestionFeedbackEvent[]
  aiSessionFeedbackEvents       AiSessionFeedbackEvent[]
  billingSubscriptions          BillingSubscription[]
  betaCampaignsCreated          BetaCampaign[]               @relation("BetaCampaignCreatedBy")
  betaGrants                    BetaGrant[]                   @relation("BetaGrantUser")
  betaGrantsAssigned            BetaGrant[]                   @relation("BetaGrantAssignedBy")
  betaGrantsRevoked             BetaGrant[]                   @relation("BetaGrantRevokedBy")
  betaApplicationsReviewed      BetaApplication[]             @relation("BetaApplicationReviewer")
  noteTasks                     NoteTask[]
  generatedPartidas             GeneratedPartida[]
  metradoSheets                 MetradoSheet[]
  customMetradoFormulas         CustomMetradoFormula[]
  budgetTemplates               BudgetTemplate[]
  emailVerificationTokens       EmailVerificationToken[]
  passwordResetTokens            PasswordResetToken[]
  adminMfaRecoveryCodes           AdminMfaRecoveryCode[]
  adminAuditLogs                 AdminAuditLog[]            @relation("AdminAuditActor")
  deletionApprovalsRequested     AdminDeletionApproval[]    @relation("DeletionApprovalRequester")
  deletionApprovalsApproved      AdminDeletionApproval[]    @relation("DeletionApprovalApprover")
  deletionApprovalTargets        AdminDeletionApproval[]    @relation("DeletionApprovalTarget")
  collaborationPresences        CollaborationPresence[]
  collaborationEditSessions     CollaborationEditSession[]
  collaborationCommentsCreated  CollaborationComment[]      @relation("CommentCreatedBy")
  collaborationCommentsResolved CollaborationComment[]      @relation("CommentResolvedBy")
  changeEvents                  BudgetChangeEvent[]
  versionSnapshots              BudgetVersionSnapshot[]
  invitedMemberships            CompanyMembership[]         @relation("MembershipInviter")
  agentExecutions               AgentExecution[]
  resourcePriceRequests         ResourcePriceUpdateRequest[] @relation("ResourcePriceRequestCreator")
  resourcePriceAppliedItems     ResourcePriceUpdateItem[]    @relation("ResourcePriceItemApplier")
  resourcePriceConfigUpdates    ResourcePriceProviderConfig[] @relation("ResourcePriceConfigUpdater")
  localPriceBatchesCreated      LocalResourcePriceBatch[]     @relation("LocalPriceBatchCreatedBy")
  localPriceBatchesPublished    LocalResourcePriceBatch[]     @relation("LocalPriceBatchPublishedBy")
  localPriceBatchesRolledBack   LocalResourcePriceBatch[]     @relation("LocalPriceBatchRolledBackBy")
  localPriceHistoryEntries      LocalResourcePriceHistory[]   @relation("LocalPriceHistoryChangedBy")
  agentDecidedApprovals         AgentApproval[]             @relation("AgentApprovalDecidedBy")
  agentRollbacks                AgentRollback[]             @relation("AgentRollbackCreatedBy")
  storedProjectPackages         StoredProjectPackage[]
  projectAttachments            ProjectAttachment[]
  riskScenarios                 RiskScenario[]
  riskSimulationRuns            RiskSimulationRun[]

  @@index([role])
  @@index([status])
  @@index([membershipPlanId])
}

model EmailVerificationToken {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model SecurityRateLimitBucket {
  id              String   @id @default(cuid())
  bucketKey       String   @unique
  windowStartedAt DateTime
  attempts        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
  @@map("security_rate_limit_buckets")
}

model AdminMfaRecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @unique
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("admin_mfa_recovery_codes")
}

model AdminDeletionApproval {
  id               String   @id @default(cuid())
  targetUserId     String?
  targetEmail      String
  requestedById    String?
  approvedById     String?
  confirmationEmail String
  reason           String
  status           String   @default("PENDING")
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  decidedAt        DateTime?
  executedAt       DateTime?
  deletionReminderSentAt DateTime?
  targetUser       User?    @relation("DeletionApprovalTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  requestedBy      User?    @relation("DeletionApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy       User?    @relation("DeletionApprovalApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([targetUserId])
  @@index([requestedById])
  @@map("admin_deletion_approvals")
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  targetUserId String?
  targetEmail  String
  action       String
  detail       String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actorUser    User?    @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model BetaCampaign {
  id                String             @id @default(cuid())
  name              String
  code              String?            @unique
  planSlug          String             @default("pro")
  durationDays      Int
  status            BetaCampaignStatus @default(DRAFT)
  assignmentMode    BetaAssignmentMode @default(ADMIN)
  startsAt          DateTime
  endsAt            DateTime?
  maxAssignments    Int?
  eligibilityRules  Json
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         User               @relation("BetaCampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  grants            BetaGrant[]

  @@index([status, startsAt])
  @@index([assignmentMode, status])
  @@map("beta_campaigns")
}

model BetaGrant {
  id           String          @id @default(cuid())
  campaignId   String
  userId       String
  companyId    String?
  planSlug     String          @default("pro")
  status       BetaGrantStatus @default(SCHEDULED)
  source       BetaGrantSource
  startsAt     DateTime
  expiresAt    DateTime
  assignedById String?
  revokedAt    DateTime?
  revokedById  String?
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  campaign     BetaCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user         User            @relation("BetaGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedBy   User?           @relation("BetaGrantAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  revokedBy    User?           @relation("BetaGrantRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([campaignId, userId])
  @@index([userId, status, expiresAt])
  @@index([campaignId, status])
  @@index([expiresAt, status])
  @@index([companyId, status])
  @@map("beta_grants")
}

model BetaApplication {
  id           String               @id @default(cuid())
  name         String
  email        String
  campaign     String               @default("founding-users-peru")
  status       BetaApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  metadata     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  reviewedBy   User?                @relation("BetaApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
  @@map("beta_applications")
}

model MarketingEvent {
  id                   String   @id @default(cuid())
  name                 String
  userId               String?
  clientId             String?
  projectId            String?
  budgetId             String?
  eventVersion         String   @default("1")
  pagePath             String?
  plan                 String?
  isDemo               Boolean?
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  utmContent           String?
  firstTouchUtmSource  String?
  firstTouchUtmMedium  String?
  firstTouchUtmCampaign String?
  firstTouchUtmContent String?
  parameters           Json?
  occurredAt           DateTime @default(now())
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, occurredAt(sort: Desc)])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([clientId, occurredAt(sort: Desc)])
  @@index([utmSource, occurredAt(sort: Desc)])
  @@map("marketing_events")
}

model MembershipPlan {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  monthlyTokenLimit    Int
  billingMode          BillingMode           @default(FREE)
  stripePriceId        String?
  projectLimit         Int?
  budgetLimit          Int?
  entitlements         String[]              @default([])
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  users                User[]
  companySubscriptions CompanySubscription[]

  @@index([isActive])
  @@index([billingMode])
  @@index([stripePriceId])
}

model BillingSubscription {
  id                   String                    @id @default(cuid())
  userId               String
  provider             BillingProvider
  status               BillingSubscriptionStatus
  stripeCustomerId     String?
  stripeSubscriptionId String?                   @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean                   @default(false)
  pastDueStartedAt     DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([stripeCustomerId])
  @@index([status])
}

model BillingWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
  payload       Json

  @@index([type, processedAt(sort: Desc)])
}

model AiUsagePeriod {
  id             String   @id @default(cuid())
  userId         String
  periodStart    DateTime
  consumedTokens Int      @default(0)
  reservedTokens Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([periodStart])
}

model AiTokenLedger {
  id              String            @id @default(cuid())
  userId          String
  adminUserId     String?
  periodStart     DateTime
  type            AiTokenLedgerType
  tokens          Int
  estimatedTokens Int?
  actualTokens    Int?
  provider        String
  model           String
  action          String
  notes           String?
  createdAt       DateTime          @default(now())
  user            User              @relation("AiTokenLedgerUser", fields: [userId], references: [id], onDelete: Cascade)
  adminUser       User?             @relation("AiTokenLedgerAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([userId, periodStart])
  @@index([adminUserId])
  @@index([action, createdAt(sort: Desc)])
}

model AiProjectHistoryEntry {
  id             String                      @id @default(cuid())
  projectId      String
  userId         String
  action         String
  summary        String
  context        Json
  answer         String
  structuredData Json?
  model          String
  requestedModel String
  fallbackUsed   Boolean                     @default(false)
  warnings       String[]                    @default([])
  latencyMs      Int?
  provider       String?
  task           String?
  promptHash     String?
  responseHash   String?
  createdAt      DateTime                    @default(now())
  project        Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbackEvents AiSuggestionFeedbackEvent[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([provider, createdAt(sort: Desc)])
  @@index([task, createdAt(sort: Desc)])
}

model AiSuggestionFeedbackEvent {
  id             String                   @id @default(cuid())
  historyEntryId String
  userId         String
  projectId      String
  feedbackType   AiSuggestionFeedbackType
  notes          String?
  provider       String?
  model          String?
  task           String?
  suggestionType String?
  actionType     String?
  promptHash     String?
  responseHash   String?
  createdAt      DateTime                 @default(now())
  historyEntry   AiProjectHistoryEntry    @relation(fields: [historyEntryId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([historyEntryId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([feedbackType, createdAt(sort: Desc)])
  @@index([provider, createdAt(sort: Desc)])
  @@index([task, createdAt(sort: Desc)])
}

model ActivityEvent {
  id        String            @id @default(cuid())
  userId    String
  type      ActivityEventType
  title     String
  detail    String
  href      String
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

model SystemSettings {
  id               String   @id @default(cuid())
  singletonKey     String   @unique @default("system")
  openaiApiKey     String?
  geminiApiKey     String?
  openrouterApiKey String?
  openaiModel      String?
  geminiModel      String?
  openrouterModel  String?
  agentModel       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([singletonKey])
}

model UserSettings {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  currencyDecimals           Int      @default(2)
  defaultCurrency            String   @default("PEN")
  dateFormat                 String   @default("DD_MMM_YYYY")
  appTheme                   String   @default("light")
  defaultViewMode            String   @default("modern")
  excelShowFieldBorders      Boolean  @default(false)
  excelRowHeight             Int      @default(40)
  defaultIgvRate             Decimal  @default(0.18) @db.Decimal(10, 4)
  defaultGeneralExpensesRate Decimal  @default(0.10) @db.Decimal(10, 4)
  defaultUtilityRate         Decimal  @default(0.08) @db.Decimal(10, 4)
  defaultSubBudgetNames      String[] @default(["Estructuras", "Arquitectura", "Instalaciones Sanitarias", "Instalaciones Electricas"])
  openaiApiKey               String?
  geminiApiKey               String?
  openrouterApiKey           String?
  aiProviderPreference       String   @default("auto")
  openaiModel                String?
  geminiModel                String?
  openrouterModel            String?
  agentModel                 String?
  floatingKhipuProvider      String   @default("ollama")
  floatingKhipuWidth         Int      @default(600)
  floatingKhipuHeight        Int      @default(500)
  floatingKhipuFontSize      String   @default("normal")
  floatingKhipuPosition      String   @default("bottom-right")
  floatingKhipuTheme         String   @default("light")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id                        String                     @id @default(cuid())
  userId                    String
  name                      String
  ruc                       String?
  logoUrl                   String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects                  Project[]
  resources                 Resource[]
  collaborationPresence     CollaborationPresence[]
  collaborationEditSessions CollaborationEditSession[]
  collaborationComments     CollaborationComment[]
  budgetChangeEvents        BudgetChangeEvent[]
  budgetVersionSnapshots    BudgetVersionSnapshot[]
  memberships               CompanyMembership[]
  subscription              CompanySubscription?
  storedProjectPackages     StoredProjectPackage[]
  betaGrants                BetaGrant[]

  @@index([userId])
}

model WorkCalendar {
  id              String                  @id @default(cuid())
  name            String
  workDays        Int                     @default(31)
  workHoursPerDay Decimal                 @default(8) @db.Decimal(6, 2)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  exceptions      WorkCalendarException[]
  projectLinks    ProjectWorkCalendar[]

  @@map("work_calendars")
}

model WorkCalendarException {
  id             String       @id @default(cuid())
  workCalendarId String
  workCalendar   WorkCalendar @relation(fields: [workCalendarId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  type           String       @default("HOLIDAY")
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([workCalendarId, date])
  @@index([workCalendarId])
  @@map("work_calendar_exceptions")
}

model ProjectWorkCalendar {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workCalendarId String
