  @@index([groupId])
}

model GeneralExpenseItem {
  id                      String                     @id @default(cuid())
  titleId                 String
  code                    String
  description             String
  category                GeneralExpenseItemCategory
  unit                    String
  quantityDescription     String?
  quantity                Decimal                    @default(0) @db.Decimal(18, 4)
  participationPercentage Decimal                    @default(0) @db.Decimal(10, 4)
  unitPrice               Decimal                    @default(0) @db.Decimal(18, 4)
  sortOrder               Int                        @default(0)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  title                   GeneralExpenseTitle        @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@index([titleId])
}

model BudgetFooterRow {
  id          String   @id @default(cuid())
  budgetId    String
  variable    String
  description String
  formula     String?
  manualValue Decimal  @default(0) @db.Decimal(18, 4)
  iu          String?
  highlight   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model Report {
  id        String     @id @default(cuid())
  budgetId  String
  type      ReportType
  fileUrl   String
  createdAt DateTime   @default(now())
  budget    Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
}

model PolynomialFormula {
  id              String                  @id @default(cuid())
  projectId       String
  budgetId        String
  name            String
  baseMonth       Int
  baseYear        Int
  totalBaseAmount Decimal                 @default(0) @db.Decimal(18, 2)
  status          PolynomialFormulaStatus @default(DRAFT)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budget          Budget                  @relation(fields: [budgetId, projectId], references: [id, projectId], onDelete: Cascade)
  monomials       PolynomialMonomial[]
  valuations      Valuation[]
  adjustments     AdjustmentCalculation[]

  @@unique([id, budgetId])
  @@index([projectId])
  @@index([budgetId])
  @@index([baseYear, baseMonth])
}

model PolynomialMonomial {
  id                   String                        @id @default(cuid())
  formulaId            String
  code                 String
  name                 String
  costGroupKey         PolynomialCostGroup
  amount               Decimal                       @default(0) @db.Decimal(18, 2)
  coefficient          Decimal                       @default(0) @db.Decimal(12, 3)
  baseIndexCode        String
  baseIndexName        String
  baseIndexValue       Decimal                       @default(0) @db.Decimal(18, 3)
  adjustmentIndexCode  String?
  adjustmentIndexName  String?
  adjustmentIndexValue Decimal?                      @db.Decimal(18, 3)
  sortOrder            Int                           @default(0)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  formula              PolynomialFormula             @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  components           PolynomialMonomialComponent[]
  adjustmentTerms      AdjustmentCalculationTerm[]

  @@unique([formulaId, sortOrder])
  @@index([formulaId])
  @@index([costGroupKey])
}

model PolynomialMonomialComponent {
  id                      String             @id @default(cuid())
  monomialId              String
  budgetItemId            String?
  apuResourceId           String?
  resourceType            String?
  amount                  Decimal            @default(0) @db.Decimal(18, 2)
  unifiedIndexCode        String?
  unifiedIndexName        String?
  iuFamily                String?
  participationPercentage Decimal?           @db.Decimal(12, 6)
  coefficientContribution Decimal?           @db.Decimal(12, 6)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  monomial                PolynomialMonomial @relation(fields: [monomialId], references: [id], onDelete: Cascade)
  budgetItem              BudgetItem?        @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  apuResource             ApuResource?       @relation(fields: [apuResourceId], references: [id], onDelete: SetNull)

  @@index([monomialId])
  @@index([budgetItemId])
  @@index([apuResourceId])
  @@index([unifiedIndexCode])
}

model UnifiedIndex {
  id             String   @id @default(cuid())
  code           String
  name           String
  category       String?
  geographicArea String   @default("UNSPECIFIED")
  month          Int
  year           Int
  value          Decimal  @default(0) @db.Decimal(18, 3)
  source         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([code, geographicArea, month, year])
  @@index([year, month])
}

model Valuation {
  id          String                  @id @default(cuid())
  budgetId    String
  formulaId   String?
  month       Int
  year        Int
  amount      Decimal                 @default(0) @db.Decimal(18, 2)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  budget      Budget                  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  formula     PolynomialFormula?      @relation(fields: [formulaId, budgetId], references: [id, budgetId], onDelete: Cascade)
  adjustments AdjustmentCalculation[]

  @@unique([budgetId, year, month])
  @@unique([id, formulaId, year, month])
  @@index([formulaId])
}

model AdjustmentCalculation {
  id               String                      @id @default(cuid())
  formulaId        String
  valuationId      String
  month            Int
  year             Int
  originalAmount   Decimal                     @default(0) @db.Decimal(18, 2)
  adjustedAmount   Decimal                     @default(0) @db.Decimal(18, 2)
  adjustmentAmount Decimal                     @default(0) @db.Decimal(18, 2)
  kRaw             Decimal                     @default(0) @db.Decimal(18, 6)
  kRounded         Decimal                     @default(0) @db.Decimal(12, 3)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  formula          PolynomialFormula           @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  valuation        Valuation                   @relation(fields: [valuationId, formulaId, year, month], references: [id, formulaId, year, month], onDelete: Cascade)
  terms            AdjustmentCalculationTerm[]

  @@unique([formulaId, year, month])
  @@unique([valuationId])
}

model AdjustmentCalculationTerm {
  id                   String                @id @default(cuid())
  adjustmentId         String
  monomialId           String
  name                 String
  coefficient          Decimal               @default(0) @db.Decimal(12, 3)
  baseIndexValue       Decimal               @default(0) @db.Decimal(18, 3)
  adjustmentIndexValue Decimal               @default(0) @db.Decimal(18, 3)
  ratio                Decimal               @default(0) @db.Decimal(18, 6)
  partial              Decimal               @default(0) @db.Decimal(18, 6)
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  adjustment           AdjustmentCalculation @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  monomial             PolynomialMonomial    @relation(fields: [monomialId], references: [id], onDelete: Cascade)

  @@unique([adjustmentId, sortOrder])
  @@index([adjustmentId])
  @@index([monomialId])
}

// ─── Stored Project Packages (.mcp repo) ──────────────────────────────────

model StoredProjectPackage {
  id                   String                       @id @default(cuid())
  companyId            String
  userId               String
  sourceProjectId      String?
  projectName          String
  projectType          String                       @default("")
  description          String                       @default("")
  mcpContent           String
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  company              Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceProject        Project?                     @relation(fields: [sourceProjectId], references: [id], onDelete: SetNull)
  budgetItemGenSources BudgetItemGenerationSource[]

  @@unique([companyId, projectName])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("stored_project_packages")
}

// ─── Khipu Agent Platform V2 ────────────────────────────────────────────────

model AgentExecution {
  id                  String                @id @default(cuid())
  userId              String
  projectId           String?
  mode                String                @default("chat")
  state               String                @default("READ")
  goal                String
  summary             String?
  provider            String?
  model               String?
  startedAt           DateTime              @default(now())
  finishedAt          DateTime?
  lastError           String?
  contextSnapshotJson Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  steps               AgentExecutionStep[]
  toolInvocations     AgentToolInvocation[]
  approvals           AgentApproval[]
  rollbacks           AgentRollback[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId])
  @@index([state, createdAt(sort: Desc)])
  @@map("agent_executions")
}

model AgentExecutionStep {
  id               String                @id @default(cuid())
  executionId      String
  sequence         Int
  title            String
  objective        String
  toolName         String?
  status           String                @default("pending")
  approvalRequired Boolean               @default(false)
  inputJson        Json?
  resultSummary    String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  execution        AgentExecution        @relation(fields: [executionId], references: [id], onDelete: Cascade)
  toolInvocations  AgentToolInvocation[]
  approvals        AgentApproval[]
  rollbacks        AgentRollback[]

  @@index([executionId, sequence])
  @@map("agent_execution_steps")
}

model AgentToolInvocation {
  id            String              @id @default(cuid())
  executionId   String
  stepId        String?
  toolName      String
  argumentsJson Json
  resultJson    Json?
  latencyMs     Int?
  success       Boolean             @default(true)
  errorMessage  String?
  createdAt     DateTime            @default(now())
  execution     AgentExecution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step          AgentExecutionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([executionId, createdAt(sort: Desc)])
  @@index([stepId])
  @@index([toolName, createdAt(sort: Desc)])
  @@map("agent_tool_invocations")
}

model AgentApproval {
  id              String              @id @default(cuid())
  executionId     String
  stepId          String?
  decision        String?
  reason          String?
  requestedAt     DateTime            @default(now())
  decidedAt       DateTime?
  decidedByUserId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  execution       AgentExecution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step            AgentExecutionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  decidedBy       User?               @relation("AgentApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@index([stepId])
  @@index([decidedByUserId])
  @@map("agent_approvals")
}

model AgentRollback {
  id                 String              @id @default(cuid())
  executionId        String
  stepId             String?
  rollbackToolName   String
  rollbackInputJson  Json?
  rollbackResultJson Json?
  success            Boolean             @default(true)
  errorMessage       String?
  reason             String?
  createdByUserId    String?
  createdAt          DateTime            @default(now())
  execution          AgentExecution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  step               AgentExecutionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  createdBy          User?               @relation("AgentRollbackCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@index([stepId])
  @@map("agent_rollbacks")
}

model AgentWorkflow {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  description         String
  initialGoalTemplate String
  allowedToolsJson    Json?
  defaultMode         String   @default("goal")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([slug])
  @@index([isActive])
  @@map("agent_workflows")
}

model ProjectAttachment {
  id        String                    @id @default(cuid())
  projectId String
  fileName  String
  fileType  String
  fileSize  Int
  filePath  String
  category  ProjectAttachmentCategory @default(OTRO)
  userId    String
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  project   Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([category])
  @@map("project_attachments")
}

model ProjectDocument {
  id               String                 @id @default(cuid())
  companyId        String
  projectId        String
  createdById      String
  name             String
  originalFileName String
  category         ReviewDocumentCategory @default(OTHER)
  status           DocumentStatus         @default(UPLOADED)
  currentVersionId String? @unique
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  currentVersion   DocumentVersion?       @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[]      @relation("DocumentVersions")

  @@unique([companyId, id])
  @@index([companyId, projectId, status])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("project_documents")
}

model DocumentVersion {
  id                 String           @id @default(cuid())
  projectDocumentId  String
  versionNumber      Int
  storageKey         String
  originalFileName   String
  mimeType           String
  fileSizeBytes      Int
  sha256             String
  pageCount          Int?
  sheetCount         Int?
  extractionStatus   ExtractionStatus @default(PENDING)
  extractionWarnings Json?
  createdAt          DateTime         @default(now())
  projectDocument    ProjectDocument  @relation("DocumentVersions", fields: [projectDocumentId], references: [id], onDelete: Cascade)
  currentFor         ProjectDocument? @relation("CurrentDocumentVersion")
  evidence           ReviewEvidence[]
  reviewRuns         ReviewRun[]

  @@unique([projectDocumentId, versionNumber])
  @@unique([projectDocumentId, sha256])
  @@index([projectDocumentId, createdAt(sort: Desc)])
  @@index([sha256])
  @@index([extractionStatus])
  @@map("document_versions")
}

model ReviewEvidence {
  id                String          @id @default(cuid())
  companyId         String
  projectId         String
  documentVersionId String
  evidenceType      EvidenceType
  originalText      String          @db.Text
  normalizedText    String?         @db.Text
  locationJson      Json
  value             Decimal?        @db.Decimal(18, 6)
  unit              String?
  extractionMethod  String
  confidence        ConfidenceLevel
  sourceHash        String
  createdAt         DateTime        @default(now())
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  entityLinks       EntityLink[]
  findings          ReviewFinding[]

  @@unique([documentVersionId, sourceHash])
  @@index([companyId, projectId, evidenceType])
  @@index([documentVersionId, createdAt(sort: Desc)])
  @@index([confidence])
  @@map("review_evidence")
}

model EntityLink {
  id               String                    @id @default(cuid())
  companyId        String
  projectId        String
  budgetId         String
  budgetItemId     String
  evidenceId       String
  signalsJson      Json
  score            Decimal                   @db.Decimal(8, 6)
  confidence       ConfidenceLevel
  validationStatus EntityLinkValidationStatus @default(PENDING)
  validatedById    String?
  validatedAt      DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budget           Budget                    @relation(fields: [budgetId, projectId], references: [id, projectId], onDelete: Cascade)
  budgetItem       BudgetItem                @relation(fields: [budgetItemId, budgetId], references: [id, budgetId], onDelete: Cascade)
  evidence         ReviewEvidence            @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  validatedBy      User?                     @relation("EntityLinkValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  findings         ReviewFinding[]

  @@unique([budgetItemId, evidenceId])
  @@index([companyId, projectId, validationStatus])
  @@index([budgetId, budgetItemId])
  @@index([evidenceId])
  @@map("entity_links")
}

model ReviewRun {
  id                       String            @id @default(cuid())
  companyId                String
  projectId                String
  budgetId                 String
  createdById              String
  configurationJson        Json
  rulesVersion             String
  status                   ReviewRunStatus   @default(DRAFT)
  progressJson             Json?
  warningsJson             Json?
  startedAt                DateTime?
  finishedAt               DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  company                  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budget                   Budget            @relation(fields: [budgetId, projectId], references: [id, projectId], onDelete: Cascade)
  createdBy                User              @relation("ReviewRunCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  documentVersions         DocumentVersion[]
  findings                 ReviewFinding[]
  auditEvents              ReviewAuditEvent[]

  @@index([companyId, projectId, status])
  @@index([budgetId, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("review_runs")
}

model ReviewFinding {
  id                       String             @id @default(cuid())
  companyId               String
  projectId               String
  budgetId                String
  reviewRunId             String
  budgetItemId            String?
  entityLinkId            String?
  evidenceId              String
  findingType             ReviewFindingType
  status                  FindingStatus      @default(OPEN)
  severity                String
  priority                Decimal            @db.Decimal(8, 6)
  confidence              ConfidenceLevel
  score                   Decimal            @db.Decimal(8, 6)
  potentialImpact         Decimal?           @db.Decimal(18, 6)
  ruleKey                 String
  comparisonJson          Json
  humanReviewRequired     Boolean            @default(true)
  automaticBudgetMutation Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  company                 Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                 Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budget                  Budget             @relation(fields: [budgetId, projectId], references: [id, projectId], onDelete: Cascade)
  reviewRun               ReviewRun          @relation(fields: [reviewRunId], references: [id], onDelete: Cascade)
  budgetItem              BudgetItem?        @relation(fields: [budgetItemId, budgetId], references: [id, budgetId], onDelete: SetNull)
  entityLink              EntityLink?        @relation(fields: [entityLinkId], references: [id], onDelete: SetNull)
  evidence                ReviewEvidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  decisions               FindingDecision[]

  @@index([companyId, projectId, status])
  @@index([reviewRunId, findingType, priority])
  @@index([budgetId, budgetItemId])
  @@index([evidenceId])
  @@map("review_findings")
}

model FindingDecision {
  id                String          @id @default(cuid())
  findingId         String
  userId            String
  resolution        FindingResolution
  note              String?         @db.Text
  expectedUpdatedAt DateTime
  createdAt         DateTime        @default(now())
  finding           ReviewFinding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("finding_decisions")
}

model ReviewAuditEvent {
  id            String        @id @default(cuid())
  companyId     String
  projectId     String
  reviewRunId   String?
  actorUserId   String?
  eventType     String
  correlationId String?
  payloadJson   Json?
  createdAt     DateTime      @default(now())
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewRun     ReviewRun?    @relation(fields: [reviewRunId], references: [id], onDelete: SetNull)
  actor         User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([companyId, projectId, createdAt(sort: Desc)])
  @@index([reviewRunId, createdAt(sort: Desc)])
  @@index([actorUserId])
  @@index([correlationId])
  @@map("review_audit_events")
}
