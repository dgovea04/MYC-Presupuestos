  SUB_BUDGET
}

enum ResourceCategory {
  MATERIAL
  LABOR
  EQUIPMENT
  TOOLS
  SUBCONTRACT
}

enum ResourcePriceProviderStatus {
  DISABLED
  HEALTHY
  DEGRADED
  SUSPENDED
}

enum ResourcePriceRequestMode {
  ON_DEMAND
  SCHEDULED
  WEBHOOK
}

enum ResourcePriceRequestStatus {
  QUEUED
  RUNNING
  PREVIEW_READY
  APPLIED
  PARTIALLY_APPLIED
  REJECTED
  FAILED
  CANCELED
}

enum ResourcePriceUpdateItemStatus {
  MATCHED
  UPDATED
  UNCHANGED
  UNMATCHED
  UNIT_MISMATCH
  CURRENCY_MISMATCH
  INVALID_PRICE
  STALE
  CONFLICT
  APPLIED
  REJECTED
  ERROR
