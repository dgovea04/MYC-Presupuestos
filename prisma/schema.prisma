model User {
  id                     String        @id @default(cuid())
  name                   String
  email                  String        @unique
  emailVerifiedAt        DateTime?
  avatarUrl              String?
  phone                  String?
  jobTitle               String?
  bio                    String?
  role                   UserRole      @default(USER)
  adminProfile           AdminProfile?
  status                 UserStatus    @default(ACTIVE)
  isSuperAdmin           Boolean       @default(false)
  mfaEnabled             Boolean       @default(false)
  mfaSecretEncrypted     String?
  passwordChangedAt      DateTime?
  sessionVersion         Int           @default(0)
  deletionScheduledAt    DateTime?
  deletionReason         String?
  deletionPreviousStatus UserStatus?
  membershipPlanId       String?
  aiTokenExtraMonthly    Int           @default(0)

  passwordHash                  String?
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  companies                     Company[]
  companyMemberships            CompanyMembership[]
  settings                      UserSettings?
  activityEvents                ActivityEvent[]
  marketingEvents               MarketingEvent[]
  membershipPlan                MembershipPlan?               @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  aiUsagePeriods                AiUsagePeriod[]
  aiUserWorkspaceUsagePeriods   AiUserWorkspaceUsagePeriod[]
  aiTokenLedger                 AiTokenLedger[]               @relation("AiTokenLedgerUser")
  aiTokenAdjustments            AiTokenLedger[]               @relation("AiTokenLedgerAdmin")
  aiCredentials                 AiCredential[]                @relation("AiCredentialUser")
  aiCredentialsCreated          AiCredential[]                @relation("AiCredentialCreator")
  aiCredentialAuditEvents       AiCredentialAuditEvent[]      @relation("AiCredentialAuditActor")
  aiProjectHistoryEntries       AiProjectHistoryEntry[]
  aiSuggestionFeedbackEvents    AiSuggestionFeedbackEvent[]
  aiSessionFeedbackEvents       AiSessionFeedbackEvent[]
  billingSubscriptions          BillingSubscription[]
  betaCampaignsCreated          BetaCampaign[]                @relation("BetaCampaignCreatedBy")
  betaGrants                    BetaGrant[]                   @relation("BetaGrantUser")
  betaGrantsAssigned            BetaGrant[]                   @relation("BetaGrantAssignedBy")
  betaGrantsRevoked             BetaGrant[]                   @relation("BetaGrantRevokedBy")
  betaApplicationsReviewed      BetaApplication[]             @relation("BetaApplicationReviewer")
  noteTasks                     NoteTask[]
  generatedPartidas             GeneratedPartida[]
  metradoSheets                 MetradoSheet[]
  customMetradoFormulas         CustomMetradoFormula[]
  budgetTemplates               BudgetTemplate[]
  emailVerificationTokens       EmailVerificationToken[]
  passwordResetTokens           PasswordResetToken[]
  adminMfaRecoveryCodes         AdminMfaRecoveryCode[]
  adminAuditLogs                AdminAuditLog[]               @relation("AdminAuditActor")
  deletionApprovalsRequested    AdminDeletionApproval[]       @relation("DeletionApprovalRequester")
  deletionApprovalsApproved     AdminDeletionApproval[]       @relation("DeletionApprovalApprover")
  deletionApprovalTargets       AdminDeletionApproval[]       @relation("DeletionApprovalTarget")
  collaborationPresences        CollaborationPresence[]
  collaborationEditSessions     CollaborationEditSession[]
  collaborationCommentsCreated  CollaborationComment[]        @relation("CommentCreatedBy")
  collaborationCommentsResolved CollaborationComment[]        @relation("CommentResolvedBy")
  changeEvents                  BudgetChangeEvent[]
  versionSnapshots              BudgetVersionSnapshot[]
  invitedMemberships            CompanyMembership[]           @relation("MembershipInviter")
  agentExecutions               AgentExecution[]
  delegationsGiven              AgentDelegation[]             @relation("AgentDelegationDelegator")
  delegationsReceived           AgentDelegation[]             @relation("AgentDelegationDelegatee")
  delegationsRevoked            AgentDelegation[]             @relation("AgentDelegationRevoker")
  resourcePriceRequests         ResourcePriceUpdateRequest[]  @relation("ResourcePriceRequestCreator")
  resourcePriceAppliedItems     ResourcePriceUpdateItem[]     @relation("ResourcePriceItemApplier")
  resourcePriceConfigUpdates    ResourcePriceProviderConfig[] @relation("ResourcePriceConfigUpdater")
  localPriceBatchesCreated      LocalResourcePriceBatch[]     @relation("LocalPriceBatchCreatedBy")
  localPriceBatchesPublished    LocalResourcePriceBatch[]     @relation("LocalPriceBatchPublishedBy")
  localPriceBatchesRolledBack   LocalResourcePriceBatch[]     @relation("LocalPriceBatchRolledBackBy")
  localPriceHistoryEntries      LocalResourcePriceHistory[]   @relation("LocalPriceHistoryChangedBy")
  agentDecidedApprovals         AgentApproval[]               @relation("AgentApprovalDecidedBy")
  agentRollbacks                AgentRollback[]               @relation("AgentRollbackCreatedBy")
  storedProjectPackages         StoredProjectPackage[]
  projectAttachments            ProjectAttachment[]
  riskScenarios                 RiskScenario[]
  workspaceAuditEvents          WorkspaceAuditEvent[]         @relation("WorkspaceAuditActor")
  workspaceInviteLinksCreated   WorkspaceInviteLink[]         @relation("WorkspaceInviteLinkCreator")
  workspaceInviteLinkUses       WorkspaceInviteLinkUse[]      @relation("WorkspaceInviteLinkUser")
  riskSimulationRuns            RiskSimulationRun[]
  projectMemberships            ProjectMembership[]
  teamMemberships               WorkspaceTeamMember[]
  reviewRunsCreated             ReviewRun[]                    @relation("ReviewRunCreatedBy")
  findingDecisions              FindingDecision[]
  reviewAuditEvents             ReviewAuditEvent[]
  projectDocumentsCreated      ProjectDocument[]
  entityLinksValidated         EntityLink[]                 @relation("EntityLinkValidator")

  @@index([role])
  @@index([status])
  @@index([membershipPlanId])
}

model EmailVerificationToken {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model SecurityRateLimitBucket {
  id              String   @id @default(cuid())
  bucketKey       String   @unique
  windowStartedAt DateTime
  attempts        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
  @@map("security_rate_limit_buckets")
}

model AdminMfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("admin_mfa_recovery_codes")
}

model AdminDeletionApproval {
  id                     String    @id @default(cuid())
  targetUserId           String?
  targetEmail            String
  requestedById          String?
  approvedById           String?
  confirmationEmail      String
  reason                 String
  status                 String    @default("PENDING")
  expiresAt              DateTime
  createdAt              DateTime  @default(now())
  decidedAt              DateTime?
  executedAt             DateTime?
  deletionReminderSentAt DateTime?
  targetUser             User?     @relation("DeletionApprovalTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  requestedBy            User?     @relation("DeletionApprovalRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy             User?     @relation("DeletionApprovalApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([targetUserId])
  @@index([requestedById])
  @@map("admin_deletion_approvals")
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  targetUserId String?
  targetEmail  String
  action       String
  detail       String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actorUser    User?    @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model BetaCampaign {
  id               String             @id @default(cuid())
  name             String
  code             String?            @unique
  planSlug         String             @default("pro")
  durationDays     Int
  status           BetaCampaignStatus @default(DRAFT)
  assignmentMode   BetaAssignmentMode @default(ADMIN)
  startsAt         DateTime
  endsAt           DateTime?
  maxAssignments   Int?
  aiTokenLimit     Int?
  eligibilityRules Json
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        User               @relation("BetaCampaignCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  grants           BetaGrant[]

  @@index([status, startsAt])
  @@index([assignmentMode, status])
  @@map("beta_campaigns")
}

model BetaGrant {
  id           String          @id @default(cuid())
  campaignId   String
  userId       String
  companyId    String?
  planSlug     String          @default("pro")
  status       BetaGrantStatus @default(SCHEDULED)
  source       BetaGrantSource
  startsAt     DateTime
  expiresAt    DateTime
  assignedById String?
  revokedAt    DateTime?
  revokedById  String?
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  campaign     BetaCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user         User            @relation("BetaGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignedBy   User?           @relation("BetaGrantAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  revokedBy    User?           @relation("BetaGrantRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([campaignId, userId])
  @@index([userId, status, expiresAt])
  @@index([campaignId, status])
  @@index([expiresAt, status])
  @@index([companyId, status])
  @@map("beta_grants")
}

model BetaApplication {
  id           String                @id @default(cuid())
  name         String
  email        String
  campaign     String                @default("founding-users-peru")
  status       BetaApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  metadata     Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  reviewedBy   User?                 @relation("BetaApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
  @@map("beta_applications")
}

model MarketingEvent {
  id                    String   @id @default(cuid())
  name                  String
  userId                String?
  clientId              String?
  projectId             String?
  budgetId              String?
  eventVersion          String   @default("1")
  pagePath              String?
  plan                  String?
  isDemo                Boolean?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmContent            String?
  firstTouchUtmSource   String?
  firstTouchUtmMedium   String?
  firstTouchUtmCampaign String?
  firstTouchUtmContent  String?
  parameters            Json?
  occurredAt            DateTime @default(now())
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, occurredAt(sort: Desc)])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([clientId, occurredAt(sort: Desc)])
  @@index([utmSource, occurredAt(sort: Desc)])
  @@map("marketing_events")
}

model MembershipPlan {
  id                    String                @id @default(cuid())
  name                  String
  slug                  String                @unique
  monthlyTokenLimit     Int
  seatLimit             Int?
  billingMode           BillingMode           @default(FREE)
  stripePriceId         String?
  projectLimit          Int?
  budgetLimit           Int?
  entitlements          String[]              @default([])
  allowKhipuChat        Boolean               @default(false)
  allowKhipuAgent       Boolean               @default(false)
  allowByok             Boolean               @default(false)
  allowWorkspaceKey     Boolean               @default(false)
  allowedAiProviders    String[]              @default([])
  allowedAiModels       String[]              @default([])
  userAiTokenLimit      Int?
  workspaceAiTokenLimit Int?
  monthlyBudgetMinor    Int?
  allowAgentWrites      Boolean               @default(false)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  users                 User[]
  companySubscriptions  CompanySubscription[]

  @@index([isActive])
  @@index([billingMode])
  @@index([stripePriceId])
}

model BillingSubscription {
  id                   String                    @id @default(cuid())
  userId               String
  provider             BillingProvider
  status               BillingSubscriptionStatus
  stripeCustomerId     String?
  stripeSubscriptionId String?                   @unique
  stripePriceId        String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean                   @default(false)
  pastDueStartedAt     DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([stripeCustomerId])
  @@index([status])
}

model BillingWebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
  payload       Json

  @@index([type, processedAt(sort: Desc)])
}

model AiUsagePeriod {
  id                 String   @id @default(cuid())
  userId             String
  workspaceId        String?
  periodStart        DateTime
  consumedTokens     Int      @default(0)
  reservedTokens     Int      @default(0)
  reservedCostMinor  Int?
  estimatedCostMinor Int?
  actualCostMinor    Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace          Company? @relation("AiUsagePeriodWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([workspaceId, periodStart])
  @@index([periodStart])
}

model AiWorkspaceUsagePeriod {
  id                 String   @id @default(cuid())
  workspaceId        String
  periodStart        DateTime
  consumedTokens     Int      @default(0)
  reservedTokens     Int      @default(0)
  reservedCostMinor  Int?
  estimatedCostMinor Int?
  actualCostMinor    Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  workspace          Company  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodStart])
  @@index([periodStart])
  @@map("ai_workspace_usage_periods")
}

model AiUserWorkspaceUsagePeriod {
  id                 String   @id @default(cuid())
  userId             String
  workspaceId        String
  periodStart        DateTime
  consumedTokens     Int      @default(0)
  reservedTokens     Int      @default(0)
  reservedCostMinor  Int?
  estimatedCostMinor Int?
  actualCostMinor    Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace          Company  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, periodStart])
  @@index([workspaceId, periodStart])
  @@index([periodStart])
  @@map("ai_user_workspace_usage_periods")
}

model AiTokenLedger {
  id                 String            @id @default(cuid())
  userId             String
  workspaceId        String?
  adminUserId        String?
  periodStart        DateTime
  type               AiTokenLedgerType
  tokens             Int
  estimatedTokens    Int?
  actualTokens       Int?
  inputTokens        Int?
  outputTokens       Int?
  reservedCostMinor  Int?
  estimatedCostMinor Int?
  actualCostMinor    Int?
  provider           String
  model              String
  action             String
  credentialSource   String?
  credentialId       String?
  billingScope       String?
  idempotencyKey     String?           @unique
  requestId          String?
  failureCode        String?
  fallbackUsed       Boolean           @default(false)
  notes              String?
  createdAt          DateTime          @default(now())
  user               User              @relation("AiTokenLedgerUser", fields: [userId], references: [id], onDelete: Cascade)
