  resourceId          String?
  rowNumber           Int
  resourceCode        String
  resourceDescription String
  unit                String
  currency            String
  proposedPrice       Decimal?                     @db.Decimal(18, 4)
  oldPrice            Decimal?                     @db.Decimal(18, 4)
  observedAt          DateTime?
  sourceLabel         String?
  notes               String?
  status              LocalResourcePriceItemStatus
  reason              String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  batch               LocalResourcePriceBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  resource            Resource?                    @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@index([resourceId, createdAt(sort: Desc)])
  @@map("local_resource_price_batch_items")
}

model LocalResourcePriceHistory {
  id          String                  @id @default(cuid())
  resourceId  String
  batchId     String
  oldPrice    Decimal                 @db.Decimal(18, 4)
  newPrice    Decimal                 @db.Decimal(18, 4)
  changedById String
  changedAt   DateTime                @default(now())
  resource    Resource                @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  batch       LocalResourcePriceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  changedBy   User                    @relation("LocalPriceHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([resourceId, changedAt(sort: Desc)])
  @@index([batchId])
  @@map("local_resource_price_history")
}

model ResourcePriceUpdateItem {
  id                 String                        @id @default(cuid())
  requestId          String
  resourceId         String?
  externalResourceId String?
  status             ResourcePriceUpdateItemStatus
  oldPrice           Decimal?                      @db.Decimal(18, 4)
  newPrice           Decimal?                      @db.Decimal(18, 4)
  oldCurrency        String?
  newCurrency        String?
  oldUnit            String?
  newUnit            String?
  priceDelta         Decimal?                      @db.Decimal(18, 4)
  priceDeltaPercent  Decimal?                      @db.Decimal(10, 4)
  matchConfidence    Decimal?                      @db.Decimal(5, 4)
  reason             String?
  appliedAt          DateTime?
  appliedById        String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  request            ResourcePriceUpdateRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  resource           Resource?                     @relation(fields: [resourceId], references: [id], onDelete: SetNull)
