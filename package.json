    "test:e2e:report": "node ./node_modules/@playwright/test/cli.js show-report",
    "stripe:version": ".\\.tools\\stripe\\stripe.exe version",
    "stripe:login": ".\\.tools\\stripe\\stripe.exe login",
    "stripe:listen": ".\\.tools\\stripe\\stripe.exe listen --forward-to localhost:3000/api/billing/webhook",
