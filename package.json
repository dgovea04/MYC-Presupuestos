    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "node ./node_modules/typescript/bin/tsc --project tsconfig.build.json --noEmit",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "prisma:seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "admin:create": "node ./node_modules/tsx/dist/cli.mjs prisma/create-admin.ts",
    "e2e:configure": "node ./node_modules/tsx/dist/cli.mjs scripts/configure-e2e-user.ts",
